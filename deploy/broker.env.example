# Copy to /etc/mobidesk-session-broker/broker.env (root:mobidesk-broker, mode 0640).
# Use the Supabase publishable/anon key only; never use service_role or sb_secret keys.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
MOBIDESK_BIND_HOST=127.0.0.1
MOBIDESK_PORT=8766
# Replace every UUID and IP below with verified values from the live libvirt/Supabase state.
# These example entries are placeholders and must never be deployed as-is.
MOBIDESK_VM_ENDPOINTS_JSON={"00000000-0000-0000-0000-000000000001":"172.16.33.11","00000000-0000-0000-0000-000000000002":"172.16.33.12","00000000-0000-0000-0000-000000000003":"172.16.33.13","00000000-0000-0000-0000-000000000004":"172.16.33.14","00000000-0000-0000-0000-000000000005":"172.16.33.15"}
MOBIDESK_GRANT_TTL_SECONDS=60
MOBIDESK_GRANT_COOLDOWN_SECONDS=2
MOBIDESK_CONNECT_TIMEOUT_SECONDS=5
MOBIDESK_SUPABASE_TIMEOUT_SECONDS=8
MOBIDESK_HEARTBEAT_SECONDS=20
MOBIDESK_MAX_MESSAGE_BYTES=1048576
MOBIDESK_MAX_SESSION_SECONDS=14400
MOBIDESK_IDLE_TIMEOUT_SECONDS=1800
MOBIDESK_MAX_SESSIONS=5
MOBIDESK_MAX_PENDING_GRANTS=10
